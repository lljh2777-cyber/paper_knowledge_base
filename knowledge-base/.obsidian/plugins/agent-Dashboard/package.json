{
  "name": "agent-dashboard",
	"version": "0.27.0",
  "private": true,
  "description": "Obsidian Research Vault dashboard plugin",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node ../../../../tool-library/tests/run_dashboard_tests.js",
		"verify": "tsc --noEmit && node esbuild.config.mjs && node ../../../../tool-library/tests/run_dashboard_tests.js",
		"obsidian:check": "node scripts/obsidian-cli.mjs check",
		"obsidian:reload": "node scripts/obsidian-cli.mjs reload",
		"obsidian:qa": "node scripts/obsidian-cli.mjs qa",
		"verify:obsidian": "npm run verify && node scripts/obsidian-cli.mjs qa"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2"
  }
}
